{
    "artifact": "nhl_cycle2_preregistration",
    "generated_before_results": true,
    "objective": "Historical NHL-only rolling walk-forward validation of strict Hodge-vs-market moneyline pocket under frozen thresholds, odds quarantine, slippage haircuts, and same-game baselines. Not live betting or betting advice.",
    "population": {
        "source": "site/data/historical_sportsbook_games.csv",
